{
  "openapi": "3.0.3",
  "info": {
    "title": "Contacts API",
    "version": "1.0.0",
    "description": "Contacts backend API documentation"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    },
    {
      "url": "https://YOUR-RENDER-URL.onrender.com"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Contacts",
      "description": "Contacts endpoints"
    },
    {
      "name": "Auth",
      "description": "Authentication endpoints",
      "tags": null
    },
    "Contacts"
  ],
  "components": {},
  "summary": "Get contact by id",
  "operationId": "getContactById",
  "description": "Get single contact",
  "parameters": [
    {
      "in": "path",
      "name": "contactId",
      "required": true,
      "description": "Contact id",
      "schema": {
        "type": "string",
        "example": "685f8a123456789"
      }
    }
  ],
  "responses": {
    "200": {
      "description": "Successfully found contact",
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "status": {
                "type": "integer",
                "example": 200
              },
              "message": {
                "type": "string",
                "example": "Successfully found contact!"
              },
              "data": {
                "type": "object",
                "properties": {
                  "_id": {
                    "type": "string",
                    "example": "685f8a123456789"
                  },
                  "name": {
                    "type": "string",
                    "example": "John Doe"
                  },
                  "phoneNumber": {
                    "type": "string",
                    "example": "+123456789"
                  },
                  "email": {
                    "type": "string",
                    "example": "john@example.com"
                  },
                  "isFavourite": {
                    "type": "boolean",
                    "example": false
                  },
                  "contactType": {
                    "type": "string",
                    "example": "work"
                  },
                  "photo": {
                    "type": "string",
                    "example": "https://example.com/photo.jpg"
                  }
                }
              }
            }
          }
        }
      }
    },
    "401": {
      "description": "Unauthorized"
    },
    "404": {
      "description": "Contact not found"
    },
    "500": {
      "description": "Server error"
    }
  }
}